{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/server.js" },
    { "source": "/admin", "destination": "/server.js" },
    { "source": "/admin/:path*", "destination": "/server.js" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/(.*)", "destination": "/$1" }
  ]
}
