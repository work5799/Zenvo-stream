# ============================================================
# Vercel Environment Variables — add all 4 in Vercel Dashboard
# Project → Settings → Environment Variables
# ============================================================

# Supabase Project URL
SUPABASE_URL=https://ztgqoqwihznpzvdtkqac.supabase.co

# Supabase service_role key (Settings → API → service_role → Reveal)
SUPABASE_SERVICE_KEY=your_service_role_key_here

# JWT secret for admin login tokens
JWT_SECRET=zenvo-stream-2026-secret

# Direct PostgreSQL URL (Supabase → Settings → Database → Connection string → URI)
# Replace [YOUR-PASSWORD] with your actual DB password
DATABASE_URL=postgresql://postgres.ztgqoqwihznpzvdtkqac:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
